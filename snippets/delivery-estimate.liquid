{% if template contains 'product' %}
  <div class="delivery-estimate-card" style="margin: 0.85rem 0; padding: 0.75rem 0.9rem; background: #fafafa; border: 1px solid #e5e5e5; border-radius: 4px; display: flex; align-items: center; gap: 0.65rem;">
    <div style="font-size: 1.1rem; line-height: 1;">🚚</div>
    <div style="font-size: 0.73rem; line-height: 1.4; color: #333;">
      <span style="font-weight: 800; color: #111; text-transform: uppercase; letter-spacing: 0.04em; display: block; margin-bottom: 0.1rem;">
        Estimated Express Delivery
      </span>
      <span>Order within <strong id="dispatch-countdown" style="color: #16a34a;">04h 22m</strong> to ship <strong id="delivery-date-range">...</strong></span>
    </div>
  </div>

  <script>
    (function() {
      // Calculate dynamic delivery dates (3 to 5 business days out)
      const today = new Date();
      const minDate = new Date(today);
      minDate.setDate(today.getDate() + 3);
      const maxDate = new Date(today);
      maxDate.setDate(today.getDate() + 5);

      const options = { month: 'short', day: 'numeric' };
      const rangeStr = minDate.toLocaleDateString('en-US', options) + ' – ' + maxDate.toLocaleDateString('en-US', options);
      
      const dateEl = document.getElementById('delivery-date-range');
      if (dateEl) dateEl.innerText = rangeStr;

      // Same-day dispatch countdown timer
      function updateDispatchTimer() {
        const now = new Date();
        const cutoff = new Date();
        cutoff.setHours(17, 0, 0, 0); // 5 PM dispatch cutoff

        if (now > cutoff) {
          cutoff.setDate(cutoff.getDate() + 1);
        }

        const diff = cutoff - now;
        const hours = Math.floor(diff / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));

        const timerEl = document.getElementById('dispatch-countdown');
        if (timerEl) {
          timerEl.innerText = `${hours}h ${minutes < 10 ? '0' : ''}${minutes}m`;
        }
      }

      updateDispatchTimer();
      setInterval(updateDispatchTimer, 60000);
    })();
  </script>
{% endif %}
