<div id="currency-switcher-bar" style="background: #111; color: #fff; text-align: center; font-size: 0.7rem; padding: 0.35rem; text-transform: uppercase; letter-spacing: 0.08em; display: flex; justify-content: center; align-items: center; gap: 0.5rem;">
  <span>Currency:</span>
  <select id="geo-currency-select" onchange="switchCurrency(this.value)" style="background: transparent; color: #fff; border: none; font-size: 0.7rem; font-weight: 700; cursor: pointer; outline: none;">
    <option value="USD" style="color: #000;">🇺🇸 USD ($)</option>
    <option value="EUR" style="color: #000;">🇪🇺 EUR (€)</option>
    <option value="GBP" style="color: #000;">🇬🇧 GBP (£)</option>
    <option value="CAD" style="color: #000;">🇨🇦 CAD ($)</option>
    <option value="AUD" style="color: #000;">🇦🇺 AUD ($)</option>
  </select>
</div>

<script>
  function switchCurrency(code) {
    const selector = document.querySelector('form[action*="/localization"] input[name="currency_code"]');
    if (selector) {
      selector.value = code;
      selector.closest('form').submit();
    } else {
      console.log('Currency switched to:', code);
    }
  }
</script>
