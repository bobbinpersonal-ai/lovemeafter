{% comment %}
  Renders the LOVEMEAFTER size guide modal (Lingerie / Swim tabs, in/cm toggle).
  Reuses Dawn's <modal-dialog> / <modal-opener> custom elements for open/close,
  focus trap, and Escape handling -- no new modal JS.

  Usage:
  {% render 'size-guide-modal' %}
{% endcomment %}

<modal-dialog id="LmaSizeGuide-{{ section.id }}" class="size-guide-modal">
  <div
    class="size-guide-modal__dialog color-{{ settings.cart_color_scheme | default: 'scheme-1' }} gradient"
    role="dialog"
    aria-modal="true"
    aria-label="Size guide"
    tabindex="-1"
  >
    <button
      id="ModalClose-LmaSizeGuide-{{ section.id }}"
      type="button"
      class="size-guide-modal__close"
      aria-label="{{ 'accessibility.close' | t }}"
    >
      {{ 'icon-close.svg' | inline_asset_content }}
    </button>

    <div class="size-guide-modal__content">
      <p class="size-guide-modal__kicker">LOVEMEAFTER — Fit Guide</p>
      <h2 class="size-guide-modal__heading">Size &amp; Measurement Guide</h2>

      <div class="size-guide-modal__controls">
        <div class="size-guide-tabs" role="tablist">
          <button type="button" class="size-guide-tabs__btn is-active" data-size-tab="lingerie" role="tab" aria-selected="true">Lingerie</button>
          <button type="button" class="size-guide-tabs__btn" data-size-tab="swim" role="tab" aria-selected="false">Swim</button>
        </div>
        <div class="size-guide-units" role="group" aria-label="Measurement unit">
          <button type="button" class="size-guide-units__btn is-active" data-size-unit="in">IN</button>
          <button type="button" class="size-guide-units__btn" data-size-unit="cm">CM</button>
        </div>
      </div>

      <div class="size-guide-panel" data-size-panel="lingerie">
        <table class="size-guide-table">
          <thead>
            <tr>
              <th scope="col">Size</th>
              <th scope="col">Bust</th>
              <th scope="col">Waist</th>
              <th scope="col">Hips</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>XS / 0–2</td>
              <td><span data-unit="in">31–33"</span><span data-unit="cm" hidden>79–84 cm</span></td>
              <td><span data-unit="in">24–25"</span><span data-unit="cm" hidden>61–64 cm</span></td>
              <td><span data-unit="in">34–35.5"</span><span data-unit="cm" hidden>86–90 cm</span></td>
            </tr>
            <tr>
              <td>S / 4–6</td>
              <td><span data-unit="in">33.5–35"</span><span data-unit="cm" hidden>85–89 cm</span></td>
              <td><span data-unit="in">26–27"</span><span data-unit="cm" hidden>66–69 cm</span></td>
              <td><span data-unit="in">36–37.5"</span><span data-unit="cm" hidden>91–95 cm</span></td>
            </tr>
            <tr>
              <td>M / 8–10</td>
              <td><span data-unit="in">35.5–37"</span><span data-unit="cm" hidden>90–94 cm</span></td>
              <td><span data-unit="in">28–29.5"</span><span data-unit="cm" hidden>71–75 cm</span></td>
              <td><span data-unit="in">38–39.5"</span><span data-unit="cm" hidden>96–100 cm</span></td>
            </tr>
            <tr>
              <td>L / 12–14</td>
              <td><span data-unit="in">37.5–39.5"</span><span data-unit="cm" hidden>95–100 cm</span></td>
              <td><span data-unit="in">30–32"</span><span data-unit="cm" hidden>76–81 cm</span></td>
              <td><span data-unit="in">40–42"</span><span data-unit="cm" hidden>101–107 cm</span></td>
            </tr>
          </tbody>
        </table>
        <p class="size-guide-modal__note">
          <strong>Fit tip:</strong> if you're between sizes, we recommend sizing up for fuller coverage.
        </p>
      </div>

      <div class="size-guide-panel" data-size-panel="swim" hidden>
        <table class="size-guide-table">
          <thead>
            <tr>
              <th scope="col">Size</th>
              <th scope="col">Bust</th>
              <th scope="col">Waist</th>
              <th scope="col">Hips</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>XS / 0–2</td>
              <td><span data-unit="in">31–32"</span><span data-unit="cm" hidden>79–81 cm</span></td>
              <td><span data-unit="in">24–25"</span><span data-unit="cm" hidden>61–64 cm</span></td>
              <td><span data-unit="in">34–35"</span><span data-unit="cm" hidden>86–89 cm</span></td>
            </tr>
            <tr>
              <td>S / 4–6</td>
              <td><span data-unit="in">33–34"</span><span data-unit="cm" hidden>84–86 cm</span></td>
              <td><span data-unit="in">26–27"</span><span data-unit="cm" hidden>66–69 cm</span></td>
              <td><span data-unit="in">36–37"</span><span data-unit="cm" hidden>91–94 cm</span></td>
            </tr>
            <tr>
              <td>M / 8–10</td>
              <td><span data-unit="in">35–36"</span><span data-unit="cm" hidden>89–91 cm</span></td>
              <td><span data-unit="in">28–29"</span><span data-unit="cm" hidden>71–74 cm</span></td>
              <td><span data-unit="in">38–39"</span><span data-unit="cm" hidden>96–99 cm</span></td>
            </tr>
            <tr>
              <td>L / 12–14</td>
              <td><span data-unit="in">37–39"</span><span data-unit="cm" hidden>94–99 cm</span></td>
              <td><span data-unit="in">30–32"</span><span data-unit="cm" hidden>76–81 cm</span></td>
              <td><span data-unit="in">40–42"</span><span data-unit="cm" hidden>101–107 cm</span></td>
            </tr>
          </tbody>
        </table>
        <p class="size-guide-modal__note">
          <strong>Fit tip:</strong> our swim fabric has four-way stretch. Size down for a sculpted fit, size up for more coverage.
        </p>
      </div>
    </div>
  </div>
</modal-dialog>

<script src="{{ 'size-guide-modal.js' | asset_url }}" defer="defer"></script>
