{% if template contains 'product' %}
  <div id="mobile-express-footer" style="display: none; position: fixed; bottom: 0; left: 0; right: 0; background: #ffffff; border-top: 1px solid #e0e0e0; padding: 0.65rem 1rem; z-index: 997; box-shadow: 0 -4px 15px rgba(0,0,0,0.08);">
    <div style="display: flex; gap: 0.5rem; align-items: center;">
      <form method="post" action="/cart/add" style="flex: 1; margin: 0;">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" style="width: 100%; background: #000; color: #fff; border: none; padding: 0.85rem; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; border-radius: 2px;">
          BUY NOW — {{ product.price | money }}
        </button>
      </form>
    </div>
  </div>

  <style>
    @media (max-width: 768px) {
      #mobile-express-footer { display: block !important; }
      body { padding-bottom: 60px; }
    }
  </style>
{% endif %}
