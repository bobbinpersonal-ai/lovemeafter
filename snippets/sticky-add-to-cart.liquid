{% comment %}
  Renders a mobile-only sticky "Add to Bag" bar, pinned to the viewport bottom once
  the shopper scrolls past the product gallery. Uses Dawn's real <product-form>
  AJAX add-to-cart element (product-form.js) -- no custom fetch logic.

  Usage:
  {% render 'sticky-add-to-cart' %}
{% endcomment %}

{%- if product != blank -%}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- assign current_variant = product.selected_or_first_available_variant -%}

<sticky-add-to-cart class="sticky-add-to-cart" data-gallery-selector=".jb-pdp-gallery">
  <div class="sticky-add-to-cart__inner page-width">
    <div class="sticky-add-to-cart__info">
      {%- if product.featured_media -%}
        <img
          src="{{ product.featured_media | image_url: width: 100 }}"
          alt=""
          width="50"
          height="{{ 50 | divided_by: product.featured_media.aspect_ratio | default: 62.5 }}"
          loading="lazy"
          class="sticky-add-to-cart__image"
        >
      {%- endif -%}
      <div class="sticky-add-to-cart__text">
        <span class="sticky-add-to-cart__title">{{ product.title }}</span>
        <span class="sticky-add-to-cart__price">{{ current_variant.price | money }}</span>
      </div>
    </div>

    <product-form class="sticky-add-to-cart__form">
      {%- form 'product', product, id: 'sticky-add-to-cart-form', class: 'sticky-add-to-cart__form-inner' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" disabled>
        <input type="hidden" name="quantity" value="1">

        <div class="product-form__error-message-wrapper" role="alert" hidden>
          <span class="product-form__error-message"></span>
        </div>

        <button
          type="submit"
          name="add"
          class="sticky-add-to-cart__submit button"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          {%- render 'loading-spinner' -%}
          <span{% if current_variant.available == false %} class="hidden"{% endif %}>
            {%- if current_variant.available -%}
              Add to Bag — {{ current_variant.price | money }}
            {%- else -%}
              Sold Out
            {%- endif -%}
          </span>
          <span class="sold-out-message hidden">Sold Out</span>
        </button>
      {%- endform -%}
    </product-form>
  </div>
</sticky-add-to-cart>

<script>
  if (!customElements.get('sticky-add-to-cart')) {
    customElements.define(
      'sticky-add-to-cart',
      class StickyAddToCart extends HTMLElement {
        connectedCallback() {
          const gallery = document.querySelector(this.dataset.gallerySelector);
          if (!gallery || !('IntersectionObserver' in window)) {
            this.classList.add('sticky-add-to-cart--visible');
            return;
          }

          this.observer = new IntersectionObserver(
            (entries) => {
              this.classList.toggle('sticky-add-to-cart--visible', !entries[0].isIntersecting);
            },
            { threshold: 0 }
          );
          this.observer.observe(gallery);
        }

        disconnectedCallback() {
          if (this.observer) this.observer.disconnect();
        }
      }
    );
  }
</script>
{%- endif -%}
