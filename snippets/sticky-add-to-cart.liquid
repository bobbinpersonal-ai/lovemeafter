{% comment %}
  Renders a mobile-only sticky "Add to Bag" bar, pinned to the viewport bottom once
  the shopper scrolls past the product gallery. Uses Dawn's real <product-form>
  AJAX add-to-cart element (product-form.js) -- no custom fetch logic.

  Usage:
  {% render 'sticky-add-to-cart' %}
{% endcomment %}

{%- if product != blank -%}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- assign current_variant = product.selected_or_first_available_variant -%}

<sticky-add-to-cart class="sticky-add-to-cart" data-gallery-selector=".jb-pdp-gallery">
  <div class="sticky-add-to-cart__inner page-width">
    <div class="sticky-add-to-cart__info">
      {%- if product.featured_media -%}
        <img
          src="{{ product.featured_media | image_url: width: 100 }}"
          alt=""
          width="50"
          height="{{ 50 | divided_by: product.featured_media.aspect_ratio | default: 62.5 }}"
          loading="lazy"
          class="sticky-add-to-cart__image"
        >
      {%- endif -%}
      <div class="sticky-add-to-cart__text">
        <span class="sticky-add-to-cart__title">{{ product.title }}</span>
        <span class="sticky-add-to-cart__price" id="StickyAtcPrice">{{ current_variant.price | money }}</span>
      </div>
    </div>

    <product-form class="sticky-add-to-cart__form">
      {%- form 'product', product, id: 'sticky-add-to-cart-form', class: 'sticky-add-to-cart__form-inner' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" id="StickyAtcVariantId" disabled>
        <input type="hidden" name="quantity" value="1">

        <div class="product-form__error-message-wrapper" role="alert" hidden>
          <span class="product-form__error-message"></span>
        </div>

        <button
          type="submit"
          name="add"
          id="StickyAtcSubmit"
          class="sticky-add-to-cart__submit button"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          {%- render 'loading-spinner' -%}
          <span class="sticky-add-to-cart__submit-text{% if current_variant.available == false %} hidden{% endif %}">
            {%- if current_variant.available -%}
              Add to Bag — {{ current_variant.price | money }}
            {%- else -%}
              Sold Out
            {%- endif -%}
          </span>
          <span class="sold-out-message hidden">Sold Out</span>
        </button>
      {%- endform -%}
    </product-form>
  </div>
</sticky-add-to-cart>

<script>
  if (!customElements.get('sticky-add-to-cart')) {
    customElements.define(
      'sticky-add-to-cart',
      class StickyAddToCart extends HTMLElement {
        connectedCallback() {
          const gallery = document.querySelector(this.dataset.gallerySelector);
          if (!gallery || !('IntersectionObserver' in window)) {
            this.classList.add('sticky-add-to-cart--visible');
            return;
          }

          this.observer = new IntersectionObserver(
            (entries) => {
              this.classList.toggle('sticky-add-to-cart--visible', !entries[0].isIntersecting);
            },
            { threshold: 0 }
          );
          this.observer.observe(gallery);
        }

        disconnectedCallback() {
          if (this.observer) this.observer.disconnect();
        }
      }
    );
  }

  if (!window.__lmaStickyAtcSyncInit) {
    window.__lmaStickyAtcSyncInit = true;
    document.addEventListener('lma:variant:change', (event) => {
      const { variant } = event.detail || {};
      const idInput = document.getElementById('StickyAtcVariantId');
      const priceEl = document.getElementById('StickyAtcPrice');
      const submitButton = document.getElementById('StickyAtcSubmit');
      if (!idInput || !submitButton) return;

      const submitText = submitButton.querySelector('.sticky-add-to-cart__submit-text');
      const soldOutMessage = submitButton.querySelector('.sold-out-message');

      if (variant) {
        idInput.value = variant.id;
        idInput.disabled = false;
        submitButton.disabled = !variant.available;
        if (priceEl) priceEl.textContent = variant.price ? `$${(variant.price / 100).toFixed(2)}` : priceEl.textContent;
        if (submitText) {
          submitText.classList.toggle('hidden', !variant.available);
          if (variant.available && priceEl) submitText.textContent = `Add to Bag — ${priceEl.textContent}`;
        }
        if (soldOutMessage) soldOutMessage.classList.toggle('hidden', variant.available);
      } else {
        idInput.disabled = true;
        submitButton.disabled = true;
      }
    });
  }
</script>
{%- endif -%}
