{% comment %}
  Renders the "Size Guide" link that opens the LOVEMEAFTER size guide modal.
  Must be rendered on the same page as {% render 'size-guide-modal' %}.

  Usage:
  {% render 'pdp-size-trigger' %}
{% endcomment %}

<modal-opener data-modal="#LmaSizeGuide-{{ section.id }}" class="pdp-size-trigger">
  <button type="button" class="pdp-size-trigger__button">
    {{- 'icon-ruler.svg' | inline_asset_content -}}
    <span>Size Guide</span>
  </button>
</modal-opener>
