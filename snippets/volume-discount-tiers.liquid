{% if template contains 'product' %}
  <div class="volume-discount-container" style="margin: 1.5rem 0; border: 1px solid #e5e5e5; padding: 1rem; border-radius: 4px; background: #fafafa;">
    <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 0.75rem 0; text-align: center;">
      🔥 Bundle & Save (Instant Discount)
    </p>

    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; text-align: center;">
      <div class="bundle-option" style="border: 1px solid #ccc; padding: 0.5rem; border-radius: 4px; background: #fff; cursor: pointer;">
        <p style="font-size: 0.7rem; font-weight: 700; margin: 0;">BUY 1</p>
        <p style="font-size: 0.65rem; color: #666; margin: 0.2rem 0 0 0;">Standard</p>
      </div>

      <div class="bundle-option active" style="border: 2px solid #000; padding: 0.5rem; border-radius: 4px; background: #fff; cursor: pointer; position: relative;">
        <span style="position: absolute; top: -8px; right: 4px; background: #000; color: #fff; font-size: 0.55rem; padding: 2px 4px; font-weight: 700; text-transform: uppercase;">Most Popular</span>
        <p style="font-size: 0.7rem; font-weight: 700; margin: 0;">BUY 2</p>
        <p style="font-size: 0.65rem; color: #d9381e; font-weight: 700; margin: 0.2rem 0 0 0;">SAVE 15%</p>
      </div>

      <div class="bundle-option" style="border: 1px solid #ccc; padding: 0.5rem; border-radius: 4px; background: #fff; cursor: pointer;">
        <p style="font-size: 0.7rem; font-weight: 700; margin: 0;">BUY 3+</p>
        <p style="font-size: 0.65rem; color: #d9381e; font-weight: 700; margin: 0.2rem 0 0 0;">SAVE 25%</p>
      </div>
    </div>
  </div>
{% endif %}
