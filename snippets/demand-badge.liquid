{% if template contains 'product' %}
  <div class="clean-demand-badge" style="display: inline-flex; align-items: center; gap: 0.5rem; background: #f4f4f5; border: 1px solid #e4e4e7; padding: 0.5rem 0.75rem; border-radius: 4px; margin: 0.75rem 0;">
    <span style="display: inline-block; width: 6px; height: 6px; background: #16a34a; border-radius: 50%;"></span>
    <span style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #27272a;">
      High Demand — Popular Choice This Season
    </span>
  </div>
{% endif %}
