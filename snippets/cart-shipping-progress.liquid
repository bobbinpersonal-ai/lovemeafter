{% comment %}
  Renders the free-shipping progress bar in the cart drawer, driven by real cart data.

  Usage:
  {% render 'cart-shipping-progress' %}
{% endcomment %}

{%- liquid
  assign threshold = settings.free_shipping_threshold | default: 100
  assign threshold_cents = threshold | times: 100
  assign remaining_cents = threshold_cents | minus: cart.total_price | at_least: 0
  assign progress_percent = cart.total_price | times: 100.0 | divided_by: threshold_cents | at_most: 100
  assign unlocked = false
  if cart.total_price >= threshold_cents
    assign unlocked = true
  endif
-%}

<div class="cart-drawer__progress">
  {%- if cart != empty -%}
  <div class="cart-shipping-progress{% if unlocked %} cart-shipping-progress--unlocked{% endif %}">
    <p class="cart-shipping-progress__message" role="status">
      {%- if unlocked -%}
        You've unlocked complimentary shipping.
      {%- else -%}
        You're <strong>{{ remaining_cents | money }}</strong> away from complimentary shipping.
      {%- endif -%}
    </p>
    <div
      class="cart-shipping-progress__track"
      role="progressbar"
      aria-valuenow="{{ progress_percent | round }}"
      aria-valuemin="0"
      aria-valuemax="100"
    >
      <div class="cart-shipping-progress__fill" style="width: {{ progress_percent }}%;"></div>
    </div>
  </div>
  {%- endif -%}
</div>
