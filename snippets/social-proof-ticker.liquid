<div id="social-proof-popup" style="position: fixed; bottom: 20px; left: 20px; background: #ffffff; border: 1px solid #e5e5e5; box-shadow: 0 4px 15px rgba(0,0,0,0.1); border-radius: 6px; padding: 0.75rem 1rem; z-index: 998; display: flex; align-items: center; gap: 0.75rem; transform: translateY(150%); transition: transform 0.4s ease-in-out; max-width: 300px;">
  <div style="width: 8px; height: 8px; background: #22c55e; border-radius: 50%; flex-shrink: 0;"></div>
  <div>
    <p id="social-proof-text" style="font-size: 0.725rem; margin: 0; line-height: 1.3; color: #111;">
      <strong>Sarah</strong> from <strong>Miami, FL</strong> just purchased <strong>Classic Black Bikini Top</strong>
    </p>
    <span style="font-size: 0.65rem; color: #888;">2 minutes ago</span>
  </div>
</div>

<script>
  (function() {
    const locations = ['Miami, FL', 'Los Angeles, CA', 'Honolulu, HI', 'Sydney, AU', 'Ibiza, ES', 'New York, NY'];
    const items = ['Classic Bikini Top', 'High-Waist Bottom', 'Sculpted One-Piece', 'Cover-Up Wrap'];
    const names = ['Jessica', 'Chloe', 'Emma', 'Sophia', 'Olivia', 'Maya'];

    function triggerSocialProof() {
      const popup = document.getElementById('social-proof-popup');
      const text = document.getElementById('social-proof-text');
      if (!popup || !text) return;

      const randomName = names[Math.floor(Math.random() * names.length)];
      const randomLoc = locations[Math.floor(Math.random() * locations.length)];
      const randomItem = items[Math.floor(Math.random() * items.length)];

      text.innerHTML = `<strong>${randomName}</strong> from <strong>${randomLoc}</strong> just purchased <strong>${randomItem}</strong>`;
      
      popup.style.transform = 'translateY(0)';
      setTimeout(() => {
        popup.style.transform = 'translateY(150%)';
      }, 5000);
    }

    document.addEventListener('DOMContentLoaded', function() {
      setTimeout(triggerSocialProof, 4000);
      setInterval(triggerSocialProof, 18000);
    });
  })();
</script>
