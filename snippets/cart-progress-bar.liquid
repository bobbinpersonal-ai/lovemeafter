<div class="cart-progress-wrapper" style="padding: 1rem 1rem 0.5rem 1rem; background: #ffffff; border-bottom: 1px solid #e5e5e5;">
  <p id="cart-progress-text" style="font-size: 0.72rem; font-weight: 800; text-transform: uppercase; text-align: center; margin: 0 0 0.5rem 0; letter-spacing: 0.05em; color: #111;">
    Add <strong style="color: #e11d48;" id="amount-away">$24.00</strong> more to unlock <strong style="color: #16a34a;">FREE EXPRESS SHIPPING</strong>
  </p>
  
  <div style="width: 100%; height: 6px; background: #f4f4f5; border-radius: 4px; overflow: hidden; position: relative;">
    <div id="cart-progress-fill" style="width: 75%; height: 100%; background: #000; transition: width 0.4s ease;"></div>
  </div>
  
  <div style="display: flex; justify-content: space-between; font-size: 0.6rem; color: #666; margin-top: 0.3rem; font-weight: 700; text-transform: uppercase;">
    <span>Cart</span>
    <span>Free Shipping ($100)</span>
  </div>
</div>

<script>
  (function() {
    const threshold = 10000; // $100.00 threshold in cents
    let currentCartTotal = 7600; // Example: $76.00 in cents

    function updateProgressBar() {
      const textEl = document.getElementById('cart-progress-text');
      const fillEl = document.getElementById('cart-progress-fill');
      const amountAwayEl = document.getElementById('amount-away');
      
      if (!textEl || !fillEl) return;

      if (currentCartTotal >= threshold) {
        textEl.innerHTML = '🎉 <strong style="color: #16a34a;">FREE EXPRESS SHIPPING UNLOCKED</strong>';
        fillEl.style.width = '100%';
        fillEl.style.background = '#16a34a';
      } else {
        const amountAway = (threshold - currentCartTotal) / 100;
        const percentage = (currentCartTotal / threshold) * 100;
        
        if (amountAwayEl) amountAwayEl.innerText = '$' + amountAway.toFixed(2);
        fillEl.style.width = percentage + '%';
        fillEl.style.background = '#000';
      }
    }

    updateProgressBar();
  })();
</script>
