{% if template contains 'product' %}
  <div class="ugc-reviews-container" style="margin: 3rem 0 1.5rem 0; border-top: 1px solid #e5e5e5; padding-top: 2rem;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem;">
      <div>
        <h4 style="font-size: 0.9rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; margin: 0;">Verified Buyer Looks</h4>
        <div style="display: flex; align-items: center; gap: 0.3rem; margin-top: 0.2rem;">
          <span style="color: #f59e0b; font-size: 0.85rem;">★★★★★</span>
          <span style="font-size: 0.75rem; font-weight: 700;">4.9 / 5.0</span>
          <span style="font-size: 0.7rem; color: #666;">(128 Verified Reviews)</span>
        </div>
      </div>
      <span style="background: #e6f4ea; color: #137333; font-size: 0.65rem; font-weight: 700; text-transform: uppercase; padding: 4px 8px; border-radius: 2px;">98% Fit Accuracy</span>
    </div>

    <!-- UGC Image Carousel Grid -->
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; margin-bottom: 1.5rem;">
      <div style="position: relative; aspect-ratio: 3/4; overflow: hidden; border-radius: 4px; background: #eee;">
        <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=400&q=80" style="width: 100%; height: 100%; object-fit: cover;">
        <span style="position: absolute; bottom: 6px; left: 6px; background: rgba(0,0,0,0.7); color: #fff; font-size: 0.6rem; padding: 2px 6px; border-radius: 2px; font-weight: 600;">Mia S. (Size M)</span>
      </div>
      <div style="position: relative; aspect-ratio: 3/4; overflow: hidden; border-radius: 4px; background: #eee;">
        <img src="https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=400&q=80" style="width: 100%; height: 100%; object-fit: cover;">
        <span style="position: absolute; bottom: 6px; left: 6px; background: rgba(0,0,0,0.7); color: #fff; font-size: 0.6rem; padding: 2px 6px; border-radius: 2px; font-weight: 600;">Elena R. (Size S)</span>
      </div>
      <div style="position: relative; aspect-ratio: 3/4; overflow: hidden; border-radius: 4px; background: #eee;">
        <img src="https://images.unsplash.com/photo-1469334031218-e382a71b716b?auto=format&fit=crop&w=400&q=80" style="width: 100%; height: 100%; object-fit: cover;">
        <span style="position: absolute; bottom: 6px; left: 6px; background: rgba(0,0,0,0.7); color: #fff; font-size: 0.6rem; padding: 2px 6px; border-radius: 2px; font-weight: 600;">Chloe K. (Size L)</span>
      </div>
      <div style="position: relative; aspect-ratio: 3/4; overflow: hidden; border-radius: 4px; background: #eee;">
        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=400&q=80" style="width: 100%; height: 100%; object-fit: cover;">
        <span style="position: absolute; bottom: 6px; left: 6px; background: rgba(0,0,0,0.7); color: #fff; font-size: 0.6rem; padding: 2px 6px; border-radius: 2px; font-weight: 600;">Jessica T. (Size XS)</span>
      </div>
    </div>
  </div>
{% endif %}
