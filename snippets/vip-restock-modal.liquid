{% if template contains 'product' %}
  <div id="vip-restock-trigger" style="margin: 0.75rem 0;">
    <button type="button" onclick="openVipModal()" style="background: transparent; border: 1px solid #111; color: #111; width: 100%; padding: 0.7rem; font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; cursor: pointer; border-radius: 2px;">
      ✨ Request Size Restock or Private Access
    </button>
  </div>

  <div id="vip-restock-modal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 9999; align-items: center; justify-content: center; padding: 1rem;">
    <div style="background: #ffffff; max-width: 420px; width: 100%; padding: 2rem 1.5rem; border-radius: 4px; text-align: center; position: relative;">
      <button onclick="closeVipModal()" style="position: absolute; top: 10px; right: 14px; background: none; border: none; font-size: 1.25rem; cursor: pointer; color: #888;">&times;</button>
      
      <span style="font-size: 0.65rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: #666;">
        LOVE ME AFTER — VIP SERVICE
      </span>
      
      <h3 style="font-size: 1.05rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; margin: 0.5rem 0 0.3rem 0;">
        Get Notified First
      </h3>
      <p style="font-size: 0.75rem; color: #555; margin-bottom: 1.25rem; line-height: 1.4;">
        Select your size to receive an instant SMS or email priority notification when this piece is restocked.
      </p>

      <div style="display: flex; flex-direction: column; gap: 0.6rem; text-align: left; margin-bottom: 1rem;">
        <input type="text" id="vip-contact-input" placeholder="Email address or phone number" style="padding: 0.65rem; font-size: 0.75rem; border: 1px solid #ccc; border-radius: 2px; width: 100%;">
      </div>

      <button type="button" onclick="submitVipRequest()" style="width: 100%; background: #000; color: #fff; border: none; padding: 0.8rem; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; cursor: pointer; border-radius: 2px;">
        Notify Me On Restock
      </button>
    </div>
  </div>

  <script>
    function openVipModal() {
      document.getElementById('vip-restock-modal').style.display = 'flex';
    }
    function closeVipModal() {
      document.getElementById('vip-restock-modal').style.display = 'none';
    }
    function submitVipRequest() {
      const val = document.getElementById('vip-contact-input').value;
      if (val) {
        alert('Thank you. You have been added to the VIP priority list.');
        closeVipModal();
      }
    }
  </script>
{% endif %}
