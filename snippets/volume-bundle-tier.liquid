{% if template contains 'product' %}
  <div class="pdp-bundle-tiers" style="margin: 1.5rem 0; border: 1px solid #111; padding: 1rem; border-radius: 4px; background: #fafafa;">
    <div style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.75rem; display: flex; justify-content: space-between; align-items: center;">
      <span>🔥 Bundle & Save More</span>
      <span style="color: #16a34a; font-weight: 700;">AUTO-APPLIED</span>
    </div>

    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
      <!-- Tier 1 -->
      <label style="display: flex; align-items: center; justify-content: space-between; padding: 0.6rem 0.8rem; background: #ffffff; border: 1px solid #ddd; border-radius: 3px; cursor: pointer;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <input type="radio" name="bundle_tier" value="1" checked style="accent-color: #000;">
          <span style="font-size: 0.75rem; font-weight: 700;">Buy 1 Piece</span>
        </div>
        <span style="font-size: 0.75rem; color: #666;">Standard Price</span>
      </label>

      <!-- Tier 2 -->
      <label style="display: flex; align-items: center; justify-content: space-between; padding: 0.6rem 0.8rem; background: #ffffff; border: 2px solid #000; border-radius: 3px; cursor: pointer; position: relative;">
        <span style="position: absolute; top: -8px; right: 10px; background: #000; color: #fff; font-size: 0.55rem; padding: 1px 6px; font-weight: 800; border-radius: 2px;">MOST POPULAR</span>
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <input type="radio" name="bundle_tier" value="2" style="accent-color: #000;">
          <span style="font-size: 0.75rem; font-weight: 700;">Buy 2 Pieces</span>
        </div>
        <span style="font-size: 0.75rem; font-weight: 800; color: #16a34a;">SAVE 15%</span>
      </label>

      <!-- Tier 3 -->
      <label style="display: flex; align-items: center; justify-content: space-between; padding: 0.6rem 0.8rem; background: #ffffff; border: 1px solid #ddd; border-radius: 3px; cursor: pointer;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <input type="radio" name="bundle_tier" value="3" style="accent-color: #000;">
          <span style="font-size: 0.75rem; font-weight: 700;">Buy 3+ Pieces</span>
        </div>
        <span style="font-size: 0.75rem; font-weight: 800; color: #16a34a;">SAVE 25%</span>
      </label>
    </div>
  </div>
{% endif %}
