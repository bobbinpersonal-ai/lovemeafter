{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

<div class="page-width section-{{ section.id }}-padding">
  <h1 class="title title--primary center">{{ section.settings.heading }}</h1>

  <div id="WishlistEmpty" class="wishlist-empty center" hidden>
    <p>{{ section.settings.empty_text }}</p>
    <a href="{{ section.settings.empty_button_link | default: '/collections/all' }}" class="button">
      {{ section.settings.empty_button_label }}
    </a>
  </div>

  <ul id="WishlistGrid" class="grid product-grid grid--2-col-tablet-down grid--4-col-desktop" role="list">
    {%- for product in collections.all.products -%}
      <li class="grid__item wishlist-item" data-wishlist-item="{{ product.handle }}" hidden>
        {% render 'card-product', card_product: product, quick_add: 'standard', section_id: section.id %}
      </li>
    {%- endfor -%}
  </ul>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .wishlist-empty {
    padding: 4rem 0;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    align-items: center;
  }
{%- endstyle -%}

{% javascript %}
  (function () {
    function render() {
      var saved = (window.__lmaWishlist ? window.__lmaWishlist.read() : []);
      var items = document.querySelectorAll('[data-wishlist-item]');
      var visibleCount = 0;
      items.forEach(function (item) {
        var isSaved = saved.indexOf(item.dataset.wishlistItem) !== -1;
        item.hidden = !isSaved;
        if (isSaved) visibleCount++;
      });
      var empty = document.getElementById('WishlistEmpty');
      var grid = document.getElementById('WishlistGrid');
      if (empty) empty.hidden = visibleCount > 0;
      if (grid) grid.hidden = visibleCount === 0;
    }

    document.addEventListener('wishlist:change', render);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', render);
    } else {
      render();
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Wishlist",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Wishlist" },
    { "type": "text", "id": "empty_text", "label": "Empty state text", "default": "Nothing saved yet. Tap the heart on anything you love." },
    { "type": "text", "id": "empty_button_label", "label": "Empty state button label", "default": "Keep Shopping" },
    { "type": "url", "id": "empty_button_link", "label": "Empty state button link" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 56 }
  ],
  "presets": [{ "name": "Wishlist" }]
}
{% endschema %}
