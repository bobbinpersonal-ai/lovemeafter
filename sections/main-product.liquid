<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 50px; max-width: 1200px; margin: 40px auto; padding: 0 20px;">
  <div class="product-images">
    <img src="{{ product.featured_image | img_url: 'master' }}" alt="{{ product.title }}" style="width: 100%; height: auto;">
  </div>
  <div class="product-info">
    <h1 style="font-weight: 300; font-size: 28px; margin: 0 0 10px;">{{ product.title }}</h1>
    <p style="font-size: 18px; color: #333;">{{ product.price | money }}</p>
    <div style="margin: 20px 0;">
      <label style="text-transform: uppercase; font-size: 12px; letter-spacing: 1px;">Size</label>
      <div style="display: flex; gap: 10px; margin-top: 10px;">
        {% for variant in product.variants %}
          <div style="border: 1px solid #ddd; padding: 10px 20px; cursor: pointer;">{{ variant.title }}</div>
        {% endfor %}
      </div>
    </div>
    <button style="width: 100%; background: #999; color: white; border: none; padding: 18px; text-transform: uppercase; font-size: 13px; letter-spacing: 1px; margin-top: 20px;">Select Your Size</button>
    <div style="margin-top: 30px; border-top: 1px solid #eee; padding-top: 20px;">
      <details><summary style="text-transform: uppercase; font-size: 13px; font-weight: bold; cursor: pointer;">Description</summary><p style="font-size: 14px; color: #555; margin-top: 10px;">{{ product.description }}</p></details>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
