{{ 'theme.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'lovemeafter-pdp.js' | asset_url }}" defer="defer"></script>

<section class="jb-pdp-container" data-section-id="{{ section.id }}">
  <!-- Mobile Editorial Gallery (Horizontal Swipe / Vertical Stack on Desktop) -->
  <div class="jb-pdp-gallery">
    {% if product.media.size > 0 %}
      {% for media in product.media %}
        <div class="jb-pdp-media-item">
          <img 
            src="{{ media | image_url: width: 1200 }}" 
            alt="{{ media.alt | escape }}" 
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            class="jb-pdp-img"
          >
        </div>
      {% endfor %}
    {% else %}
      <div class="jb-pdp-media-item">
        {{ 'product-1' | placeholder_svg_tag: 'jb-pdp-img' }}
      </div>
    {% endif %}
  </div>

  <!-- PDP Form & High-Conversion Panel -->
  <div class="jb-pdp-details">
    <div class="jb-pdp-sticky-inner">
      
      <!-- Fabric Tag & Header -->
      <span class="jb-card-fabric">
        {% if product.metafields.custom.fabric %}
          {{ product.metafields.custom.fabric }}
        {% else %}
          LOVEMEAFTER
        {% endif %}
      </span>
      
      <h1 class="jb-pdp-title">{{ product.title }}</h1>
      <p class="jb-pdp-price" id="ProductPrice-{{ section.id }}">
        {{ product.selected_or_first_available_variant.price | money }}
      </p>

      <div class="jb-pdp-description rte">
        {{ product.description }}
      </div>

      <!-- Variant Form -->
      <script type="application/json" id="ProductVariants-{{ section.id }}">
        {{ product.variants | json }}
      </script>

      <product-form class="jb-product-form-wrapper" id="jb-product-form-{{ section.id }}" data-section-id="{{ section.id }}">
        {% form 'product', product, id: 'jb-product-form', class: 'jb-product-form' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" disabled>
          <input type="hidden" name="quantity" value="1">

          <!-- Option Selectors (Color & Size) -->
          {% for option in product.options_with_values %}
            <div class="jb-option-group" data-option-position="{{ option.position }}">
              <div class="jb-option-header">
                <span class="jb-option-label">{{ option.name | uppercase }}:</span>
                <span class="jb-option-selected" id="selected-{{ option.name | handle }}-{{ section.id }}">{{ option.selected_value }}</span>
              </div>

              <div class="jb-option-values">
                {% for value in option.values %}
                  <button
                    type="button"
                    class="jb-option-btn {% if option.selected_value == value %}active{% endif %}"
                    data-option-position="{{ option.position }}"
                    data-value="{{ value | escape }}"
                  >
                    {{ value }}
                  </button>
                {% endfor %}
              </div>
            </div>
          {% endfor %}

          {% render 'pdp-size-trigger' %}

          <div class="product-form__error-message-wrapper" role="alert" hidden>
            <span class="product-form__error-message"></span>
          </div>

          <!-- High-Converting Add To Cart Button -->
          <button
            type="submit"
            name="add"
            id="ProductSubmitButton-{{ section.id }}"
            class="btn-checkout jb-add-to-cart"
            {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
          >
            {%- render 'loading-spinner' -%}
            <span class="jb-add-to-cart__text{% if product.selected_or_first_available_variant.available == false %} hidden{% endif %}">
              {%- if product.selected_or_first_available_variant.available -%}
                ADD TO BAG — {{ product.selected_or_first_available_variant.price | money }}
              {%- else -%}
                SOLD OUT
              {%- endif -%}
            </span>
            <span class="sold-out-message hidden">SOLD OUT</span>
          </button>
        {% endform %}
      </product-form>

      <!-- Trust & Frictionless Shipping Perks -->
      <div class="jb-pdp-perks">
        <div class="jb-perk-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12l5 5L20 7"/></svg>
          <span>Free shipping on orders over $150</span>
        </div>
        <div class="jb-perk-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12l5 5L20 7"/></svg>
          <span>Easy 30-day hassle-free returns</span>
        </div>
      </div>

    </div>
  </div>
</section>

{% render 'size-guide-modal' %}

{% schema %}
{
  "name": "Product information",
  "settings": [],
  "presets": [
    {
      "name": "Product information"
    }
  ]
}
{% endschema %}