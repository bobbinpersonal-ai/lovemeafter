{{ 'section-hero-editorial.css' | asset_url | stylesheet_tag }}

<section class="hero-editorial">
  <div class="hero-editorial__media" data-transparent-header-boundary>
    {%- if section.settings.mobile_image != blank or section.settings.image != blank -%}
      <picture>
        {%- if section.settings.mobile_image != blank -%}
          <source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}">
        {%- endif -%}
        <img
          src="{{ section.settings.image | default: section.settings.mobile_image | image_url: width: 2000 }}"
          alt="{{ section.settings.image.alt | default: section.settings.mobile_image.alt | escape }}"
          loading="eager"
          width="{{ section.settings.image.width | default: 2000 }}"
          height="{{ section.settings.image.height | default: 1250 }}"
          class="hero-editorial__image"
        >
      </picture>
    {%- else -%}
      <div class="hero-editorial__placeholder">
        <span>HERO IMAGE — upload via Theme Editor</span>
      </div>
    {%- endif -%}
  </div>

  <div class="hero-editorial__band color-{{ section.settings.color_scheme }} gradient">
    <div class="hero-editorial__content page-width">
      {%- if section.settings.kicker != blank -%}
        <p class="hero-editorial__kicker">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="hero-editorial__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="hero-editorial__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
        <div class="hero-editorial__actions">
          {%- if section.settings.button_1_label != blank -%}
            <a href="{{ section.settings.button_1_link | default: '#' }}" class="button">
              {{ section.settings.button_1_label }}
            </a>
          {%- endif -%}
          {%- if section.settings.button_2_label != blank -%}
            <a href="{{ section.settings.button_2_link | default: '#' }}" class="button button--secondary">
              {{ section.settings.button_2_label }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero (editorial)",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Band color scheme", "default": "scheme-4" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "LINGERIE · SWIM · AFTER DARK" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "FOR THE HOURS AFTER." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Lingerie, swim & pieces made to be seen." },
    { "type": "text", "id": "button_1_label", "label": "Button 1 label", "default": "SHOP LINGERIE" },
    { "type": "url", "id": "button_1_link", "label": "Button 1 link" },
    { "type": "text", "id": "button_2_label", "label": "Button 2 label", "default": "SHOP SWIM" },
    { "type": "url", "id": "button_2_link", "label": "Button 2 link" }
  ],
  "presets": [{ "name": "Hero (editorial)" }]
}
{% endschema %}
