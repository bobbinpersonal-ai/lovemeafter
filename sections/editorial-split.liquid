{{ 'section-editorial-split.css' | asset_url | stylesheet_tag }}

<section class="editorial-split{% if section.settings.image_position == 'right' %} editorial-split--image-right{% endif %}">
  <div class="editorial-split__media">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1400 }}"
        alt="{{ section.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
      >
    {%- else -%}
      <div class="editorial-split__placeholder">
        <span>IMAGE — upload via Theme Editor</span>
      </div>
    {%- endif -%}
  </div>
  <div class="editorial-split__text color-{{ section.settings.color_scheme }} gradient">
    <div class="editorial-split__text-inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="editorial-split__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="editorial-split__body">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="button">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial split",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Text panel color scheme", "default": "scheme-4" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "LINGERIE YOU CAN LEAVE THE HOUSE IN." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>A lace bodysuit under a blazer. A bikini with tailored trousers. A slip after midnight.</p><p>LOVEMEAFTER lives somewhere between lingerie and fashion.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP AFTER DARK" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Editorial split" }]
}
{% endschema %}
