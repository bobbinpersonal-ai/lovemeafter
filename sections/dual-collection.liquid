<section class="dual-look" style="display: grid; grid-template-columns: 1fr 1fr; gap: 0; width: 100%;">
  <div class="col" style="position: relative;">
    <img src="{{ section.settings.left_img | img_url: 'master' }}" style="width: 100%; height: 500px; object-fit: cover;">
    <div style="position: absolute; bottom: 30px; left: 30px; color: white;">
      <h3 style="font-weight: 300; letter-spacing: 2px; text-transform: uppercase;">{{ section.settings.left_title }}</h3>
    </div>
  </div>
  <div class="col" style="position: relative;">
    <img src="{{ section.settings.right_img | img_url: 'master' }}" style="width: 100%; height: 500px; object-fit: cover;">
    <div style="position: absolute; bottom: 30px; right: 30px; color: white; text-align: right;">
      <h3 style="font-weight: 300; letter-spacing: 2px; text-transform: uppercase;">{{ section.settings.right_title }}</h3>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Build The Look",
  "settings": [
    { "type": "image_picker", "id": "left_img", "label": "Left Image" },
    { "type": "text", "id": "left_title", "label": "Left Title", "default": "Tanks" },
    { "type": "image_picker", "id": "right_img", "label": "Right Image" },
    { "type": "text", "id": "right_title", "label": "Right Title", "default": "Bottoms" }
  ]
}
{% endschema %}
