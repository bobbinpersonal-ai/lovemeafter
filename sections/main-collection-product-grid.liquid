{{ 'theme.css' | asset_url | stylesheet_tag }}

<div class="jb-collection-container">
  <div class="jb-collection-grid">
    {% for product in collection.products %}
      <div class="jb-card">
        <a href="{{ product.url }}" class="jb-card-image-wrapper">
          {% if product.featured_media %}
            <img 
              src="{{ product.featured_media | image_url: width: 800 }}" 
              alt="{{ product.featured_media.alt | escape }}" 
              class="jb-card-image"
              loading="lazy"
            >
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'jb-card-image' }}
          {% endif %}
        </a>

        <div class="jb-card-details">
          <span class="jb-card-fabric">
            {% if product.metafields.custom.fabric %}
              {{ product.metafields.custom.fabric }}
            {% else %}
              SIGNATURE COLLECTION
            {% endif %}
          </span>
          
          <div class="jb-card-title-row">
            <h3 class="jb-card-title">
              <a href="{{ product.url }}" style="text-decoration:none; color:inherit;">
                {{ product.title }}
              </a>
            </h3>
            <span class="jb-card-price">{{ product.price | money_without_trailing_zeros }}</span>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Product grid",
  "settings": []
}
{% endschema %}