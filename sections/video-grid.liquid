{{ 'section-video-grid.css' | asset_url | stylesheet_tag }}

<section class="video-grid color-{{ section.settings.color_scheme }} gradient page-width">
  {%- if section.settings.heading != blank -%}
    <h2 class="video-grid__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="video-grid__row">
    {%- for block in section.blocks -%}
      <div class="video-grid__item" {{ block.shopify_attributes }}>
        {%- if block.settings.video != blank -%}
          {{
            block.settings.video
            | video_tag:
              image_size: '600x',
              autoplay: true,
              loop: true,
              muted: true,
              playsinline: true,
              controls: false
          }}
        {%- else -%}
          <div class="video-grid__placeholder">
            <span>VIDEO — upload via Theme Editor</span>
          </div>
        {%- endif -%}

        {%- if block.settings.caption != blank or block.settings.link != blank -%}
          <div class="video-grid__overlay">
            {%- if block.settings.caption != blank -%}
              <span class="video-grid__caption">{{ block.settings.caption }}</span>
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="video-grid__link">Shop this</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Video grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Product / collection link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video grid",
      "blocks": [{ "type": "video" }, { "type": "video" }, { "type": "video" }]
    }
  ]
}
{% endschema %}
