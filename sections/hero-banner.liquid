<section class="hero" style="position: relative; width: 100%; height: 600px; background-image: url('{{ section.settings.bg_image | img_url: 'master' }}'); background-size: cover; background-position: center; display: flex; align-items: flex-end; justify-content: flex-start; padding: 60px;">
  <div class="hero-text" style="background: white; padding: 30px; max-width: 400px;">
    <h2 style="font-family: Georgia, serif; font-weight: 300; font-size: 32px; margin: 0 0 15px;">{{ section.settings.heading }}</h2>
    <a href="{{ section.settings.btn_link }}" style="display: inline-block; border: 1px solid black; padding: 12px 30px; text-decoration: none; color: black; text-transform: uppercase; font-size: 12px; letter-spacing: 1px;">{{ section.settings.btn_text }}</a>
  </div>
</section>
{% schema %}
{
  "name": "Joah Hero",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Hero Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Foundation." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Shop Now" },
    { "type": "url", "id": "btn_link", "label": "Button Link" }
  ]
}
{% endschema %}
