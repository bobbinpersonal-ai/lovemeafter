<footer style="padding: 60px 40px 30px; border-top: 1px solid #eee; background: white;">
  <div style="max-width: 1200px; margin: auto; display: flex; flex-wrap: wrap; justify-content: space-between;">
    <div style="flex: 1; min-width: 200px;">
      <h3 style="text-transform: uppercase; font-size: 12px; letter-spacing: 1px;">Shop</h3>
      <ul style="list-style: none; padding: 0; font-size: 13px; color: #555;">
        <li style="margin-bottom: 5px;"><a href="#" style="text-decoration: none; color: #555;">All</a></li>
        <li style="margin-bottom: 5px;"><a href="#" style="text-decoration: none; color: #555;">New</a></li>
        <li style="margin-bottom: 5px;"><a href="#" style="text-decoration: none; color: #555;">Best Sellers</a></li>
      </ul>
    </div>
    <div style="flex: 1; min-width: 200px;">
      <h3 style="text-transform: uppercase; font-size: 12px; letter-spacing: 1px;">Support</h3>
      <ul style="list-style: none; padding: 0; font-size: 13px; color: #555;">
        <li style="margin-bottom: 5px;"><a href="#" style="text-decoration: none; color: #555;">Shipping</a></li>
        <li style="margin-bottom: 5px;"><a href="#" style="text-decoration: none; color: #555;">Returns</a></li>
        <li style="margin-bottom: 5px;"><a href="#" style="text-decoration: none; color: #555;">Contact</a></li>
      </ul>
    </div>
    <div style="flex: 1; min-width: 250px;">
      <h3 style="text-transform: uppercase; font-size: 12px; letter-spacing: 1px;">Sign up for 15% off</h3>
      <p style="font-size: 12px; color: #777;">Plus free U.S. shipping.</p>
      <form action="#" style="display: flex; border-bottom: 1px solid black; padding-bottom: 10px; margin-top: 15px;">
        <input type="email" placeholder="Email" style="border: none; outline: none; flex: 1; font-size: 13px;">
        <button type="submit" style="border: none; background: none; cursor: pointer;">Subscribe</button>
      </form>
    </div>
  </div>
  <div style="text-align: center; margin-top: 40px; font-size: 11px; color: #888;">
    <p>Copyright © 2026 {{ shop.name }}. Designed in Los Angeles.</p>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
