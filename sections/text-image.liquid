<section style="display: grid; grid-template-columns: 1fr 1fr; gap: 0; background: #f9f9f9;">
  <div style="padding: 80px; display: flex; flex-direction: column; justify-content: center; text-align: left;">
    <h2 style="font-family: Georgia, serif; font-weight: 300; font-size: 32px; margin: 0 0 20px;">{{ section.settings.heading }}</h2>
    <p style="font-size: 14px; line-height: 1.6; color: #555; max-width: 400px; margin-bottom: 30px;">{{ section.settings.text }}</p>
    <a href="{{ section.settings.btn_link }}" style="border-bottom: 1px solid black; text-decoration: none; color: black; text-transform: uppercase; font-size: 12px;">{{ section.settings.btn_text }}</a>
  </div>
  <div>
    <img src="{{ section.settings.image | img_url: 'master' }}" alt="Brand Story" style="width: 100%; height: 100%; object-fit: cover;">
  </div>
</section>
{% schema %}
{
  "name": "Story Section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your story headline" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Add your own editorial copy here." },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Our Story" },
    { "type": "url", "id": "btn_link", "label": "Button Link" },
    { "type": "image_picker", "id": "image", "label": "Side Image" }
  ]
}
{% endschema %}
