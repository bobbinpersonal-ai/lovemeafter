{{ 'section-social-grid.css' | asset_url | stylesheet_tag }}

<section class="social-grid page-width">
  {%- if section.settings.heading != blank -%}
    <h2 class="social-grid__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="social-grid__row">
    {%- for block in section.blocks -%}
      {%- assign tag = 'div' -%}
      {%- if block.settings.link != blank -%}{%- assign tag = 'a' -%}{%- endif -%}
      <{{ tag }}
        {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
        class="social-grid__item"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 600 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="600"
            height="600"
          >
        {%- else -%}
          <div class="social-grid__placeholder"><span>IMAGE</span></div>
        {%- endif -%}
      </{{ tag }}>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Social grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "@LOVEMEAFTER" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social grid",
      "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }]
    }
  ]
}
{% endschema %}
